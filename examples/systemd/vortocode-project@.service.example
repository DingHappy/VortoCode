# VortoCode 常驻电脑上的项目运行时 —— 每个项目一个实例（systemd 用户模板单元）。
#
# Desktop 工作台「在哪做：本机 / 常驻电脑」切到常驻电脑时，连的就是这里。
#
# 装（服务器上，以运行用户身份；每加一个项目重复 2–4）：
#   1. cp examples/systemd/vortocode-project@.service.example ~/.config/systemd/user/vortocode-project@.service
#   2. git clone <仓库> ~/projects/<名字>          （**与部署目录分开**：agent 在这里改代码）
#   3. echo "VORTOCODE_PROJECT_PORT=8082" > ~/.config/vortocode/projects/<名字>.env
#   4. systemctl --user daemon-reload && systemctl --user enable --now vortocode-project@<名字>
#   5. 登记到 ~/.vortocode/resident_projects.json（常驻助理据此告诉 Desktop 有哪些项目）：
#        {"projects": [{"name": "<名字>", "repo_root": "/home/<用户>/projects/<名字>", "port": 8082}]}
#
# ExecStart 用 vc 入口而不是 `python -m src.cli`：-m 会把工作目录放进 sys.path，项目恰好是
# VortoCode 本身时，就会加载 agent 刚改过的代码来跑服务。vc 走 editable 安装，只认部署目录。

[Unit]
Description=VortoCode project runtime (%i) for Desktop "run on resident computer"
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 项目 clone 与部署目录分开：agent 在这里改代码，不会改到正在跑的服务本身
WorkingDirectory=%h/projects/%i
EnvironmentFile=%h/.config/vortocode/projects/%i.env
Environment=VORTOCODE_WORKSPACE_SCOPE=project
Environment=VORTOCODE_IM=
Environment=VORTOCODE_CRON=0
Environment=VORTOCODE_HEARTBEAT=0
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HTTP_PROXY=http://<代理>:7890
Environment=HTTPS_PROXY=http://<代理>:7890
Environment=NO_PROXY=127.0.0.1,localhost
# 用 vc 入口（editable 安装指向部署目录）：不会从 cwd 导入项目里的 src
ExecStart=/bin/sh -c "exec %h/personal_project/VortoCode/.venv/bin/vc server --host 0.0.0.0 --port $VORTOCODE_PROJECT_PORT"
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
