# VortoCode 环境变量配置

# One API 网关配置
OPENAI_API_BASE=https://relay.dinghappy.com/v1
OPENAI_API_KEY=sk-你的令牌

# 可选：Anthropic 兼容接口
ANTHROPIC_BASE_URL=https://relay.dinghappy.com
ANTHROPIC_AUTH_TOKEN=sk-你的令牌

# 默认模型
DEFAULT_MODEL=mimo-v2.5

# 工具调用协议：默认提示式（模型无关）。**支持 function-calling 的模型（如 mimo-v2.5）强烈建议开
# native**——真机对照 dogfood 显示，同一开发任务 native 3/3 正确落地、提示式仅 1/3（其余把工具结果
# 误当用户消息、凭空编造交付）。三端（TUI/Web/CLI）统一生效；模型不支持会自动回退提示式。
# VORTOCODE_NATIVE_TOOLS=1

# 记忆系统
MEMORY_STORAGE_PATH=.vortocode/memory

# 日志
LOG_LEVEL=INFO
LOG_FILE=.vortocode/logs/app.log

# Web 服务器
WEB_HOST=0.0.0.0
WEB_PORT=8000
