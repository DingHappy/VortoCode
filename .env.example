# VortoCode 环境变量配置

# 模型服务：任何 OpenAI 兼容接口（OpenAI、DeepSeek、Kimi、智谱、千问、自建 One API 网关、本机 Ollama……）。
# 三项都要填：地址、Key、模型名。
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key
DEFAULT_MODEL=gpt-4o-mini

# 可选：Anthropic 或兼容网关。设了这两个就自动登记成名为 `anthropic` 的端点（见下面的模型分层）。
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=sk-ant-your-api-key

# ── 模型分层：让一条流水线上的各道工序跑在不同厂商的模型上（"agent 蜂群"）──────────────
# 不配 = 全部走 DEFAULT_MODEL，行为与从前完全一致。两种接法可混用：
#
# ① 全挂在自建 One API 中转站后面 —— 端点只有一个，工序之间只换模型名：
# VORTOCODE_MODEL_ROLES=decompose=gpt-5,implement=mimo-v2.5,review=claude-sonnet-5
#
# ② 直连各家官方端点 —— 每家自带 base_url + key，写成 `工序=端点:模型`：
# VORTOCODE_PROVIDER_OPENAI_BASE=https://api.openai.com/v1
# VORTOCODE_PROVIDER_OPENAI_KEY=sk-...
# VORTOCODE_MODEL_ROLES=review=anthropic:claude-sonnet-5,decompose=openai:gpt-5
#
# 可用工序名：decompose（拆解）/ implement（隔离实现）/ review（PR 前对抗审查）/ research（只读调研）。
# `.vortocode/agents/*.md` 里的 `model:` 同样支持 `端点:模型`。
# Desktop 也可在设置 → 模型 → 高级模型选项里配置 research / implement / review / assess。
# assess 留空关闭额外评判；配置后由 task_model_assess 按需调用，不自动升级或验收。
# VORTOCODE_MODEL_ROLES=research=default:reader-model,assess=default:judge-model
# 把隔离 dev 流水线的「实现 / 审查」交给本机 Codex CLI 或 Claude Code CLI（需先安装并登录）。
# 优先于上面的模型分工；详见 docs/MODEL_ROUTING.md「外部执行者」。
# 实验功能，默认关闭：必须先打开这个开关，下面的角色表才生效。
# VORTOCODE_EXPERIMENTAL_EXTERNAL_WORKERS=1
# VORTOCODE_EXTERNAL_WORKERS=implement=codex,review=claude
# VORTOCODE_EXTERNAL_WORKER_TIMEOUT=1800
# 每百万 token 的运行方单价示例（虚构，不是报价）；未配置保持未知，详见 docs/MODEL_ROUTING.md。
# VORTOCODE_MODEL_PRICES={"default:reader-model":{"input_per_million":1,"output_per_million":2,"currency":"CNY"}}
# 聊天框选择控制主 Agent；子 Agent 分工不会跟随本回合临时切换。详见 docs/MODEL_ROUTING.md。
#
# 怎么分——判据是"这一步错了代价多大"，不是"这一步简不简单"：
#   · decompose 只跑一次、token 最少，但拆错了后面全白干 → 用最强的，省它毫无意义；
#   · implement 是烧钱大头也最吃能力，换弱模型省的钱会被重试吃回去，人还得多等几倍；
#   · review 是**异厂商**最有价值的地方，理由是独立性不是强弱：同一个模型自己审自己写的
#     实现，会系统性漏掉自己的盲区（实现时认为对的，审时还是认为对）。
#
# 安全底线：一个端点的 key **绝不外借**。声明了端点却没给 key 的一律不可用，宁可回落默认，
# 也不会把中转站的 key 发到另一家厂商的地址上。配错只回落 + 记警告，不会打死流水线。

# 默认模型
DEFAULT_MODEL=mimo-v2.6-pro

# 可选：改用 OpenAI 官方接口
# OPENAI_API_BASE=https://api.openai.com/v1
# DEFAULT_MODEL=gpt-4o-mini

# 上下文历史预算（token）。默认按**当前模型的窗口自适应**：gpt-4o/claude 等已知大窗口模型自动放大，
# Desktop 会先读取服务端 /models 能力字段，拿不到时再用已核实的官方模型目录；当前
# mimo-v2.5=1M、mimo-v2.5-base=256K。私有/别名模型仍可在这里显式覆盖实际部署上限。
# VORTOCODE_MODEL_CONTEXT_WINDOW=1000000
# 中转上跑**多个**模型、各自窗口不同时，用按模型表（前缀匹配，优先于上面的全局值）：
# VORTOCODE_MODEL_CONTEXT_WINDOWS=mimo-v2.5=1000000,mimo-v2.5-base=256000
# 自适应取窗口的比例（默认 0.5，给系统提示/工具/输出留空间）与绝对硬顶（默认 200000）：
# VORTOCODE_CONTEXT_WINDOW_FRACTION=0.5
# VORTOCODE_CONTEXT_BUDGET_CAP=200000
# 想精确钉死历史预算、彻底关掉自适应：设这个（优先级最高）。
# VORTOCODE_MAX_CONTEXT_TOKENS=8000

# 单段执行预算（一段里最多几轮"模型→工具"）。plan 只读摸底默认 6；build 要读→改→跑测试→
# 再改，默认 16。到段尾会自动续跑（VORTOCODE_BUILD_AUTO_CONTINUES 段，默认 3），
# 这些阈值只防模型空转，不该成为正常开发的停止点。
# VORTOCODE_MAX_STEPS=6
# VORTOCODE_BUILD_MAX_STEPS=16
# 单个Agent的用户回合最多12次web_search/web_fetch派发，跨Build续跑累计；1–64。
# 到限停止检索并收尾；不是provider token/时间硬预算，也不覆盖子Agent总用量。
# VORTOCODE_MAX_WEB_TOOL_CALLS=12
# VORTOCODE_BUILD_AUTO_CONTINUES=3

# 模型请求：OPENAI_TIMEOUT 是**空闲**超时（多久没收到任何字节算卡死），默认 30 秒；
# 只要还在持续吐分片，长生成就不会被掐断。OPENAI_REQUEST_TIMEOUT 是整次请求的硬上限，
# 默认 900 秒，只防"一直滴水、永远不完"的病态连接。默认不静默重试，避免重复计费。
# OPENAI_TIMEOUT=30
# OPENAI_REQUEST_TIMEOUT=900
# OPENAI_MAX_RETRIES=0
# 自定义 OpenAI 兼容服务默认不发送可选 stream_options（避免不兼容时超时后重复生成）；
# 服务明确支持流式 usage 时可开启，OpenAI 官方端点默认开启。
# VORTOCODE_STREAM_USAGE=1

# 注入上限。默认刻意保守：这些字节落在**当前回合**，而当前回合恰是 microcompaction（只折老段）
# 与裁剪（最新一条永远保留）都够不着的区域——入口给多了，后面没有任何机制能回收；并行几个
# read_file 就能让一条消息吃掉几倍于整个历史预算的空间。窗口确实大（如已配 131072）再按需调高：
# VORTOCODE_MAX_TOOL_RESULT=4000    # 单个工具结果回灌上限（字符）
# VORTOCODE_MAX_READ_FILE=6000      # read_file 整文件截断上限（字符）
# VORTOCODE_AT_FILE_CHARS=3000      # TUI @file 注入上限（字符）
# VORTOCODE_AT_DIR_FILES=50         # TUI @dir 列出的文件数上限

# 工具调用协议：**默认原生 function-calling（native）**——对支持的模型更可靠（真机 dogfood：
# native 3/3 正确落地 vs 提示式 1/3，提示式下模型易把工具结果误当用户消息、凭空编造交付）；模型
# 不支持会自动回退提示式（模型无关兜底）。三端统一。要强制提示式：置 0。
# VORTOCODE_NATIVE_TOOLS=0

# dev_auto 的 PR 前对抗审查段：**默认开**——集成绿后、开 PR 前跑一个专职挑刺的 reviewer 子 agent
# （只报 P0/P1、每条带验证证据、confirmed 喂一轮自修复、修不掉就不开 PR）。要关（省一轮 LLM）：置 0。
# VORTOCODE_DEV_REVIEW=0

# IM 通道桥（vc im telegram）——把主 agent 搬上 Telegram（手机发任务/按钮确认/回报）。
# 安全配对：在私密环境设置 token 后，运行 vc im-pair telegram，终端会给 10 分钟的一次性码；
# 用自己的 Telegram 私聊机器人发送 /bind <码>。owner ID 保存在仓库外，重启/轮换 token 后仍有效。
# 显式 VORTOCODE_TG_OWNER_ID 仍可用于已有部署，但新部署不必预先知道 ID。
# VORTOCODE_TG_TOKEN=123456:ABC-your-bot-token
# VORTOCODE_TG_OWNER_ID=123456789

# IM 通道桥（vc im dingtalk）——钉钉 Stream 模式（出站 WS 长连，零入站暴露）。配对制 fail-closed。
# 钉钉开放平台建"企业内机器人"应用（Stream 模式）拿 AppKey(=ClientID)/AppSecret；OWNER_ID 填你自己的
# senderStaffId（给机器人发条消息，回调里能看到）。确认走文本（回复 y/n），钉钉无内联按钮。
# VORTOCODE_DD_CLIENT_ID=dingxxxxappkey
# VORTOCODE_DD_CLIENT_SECRET=your-app-secret
# VORTOCODE_DD_OWNER_ID=your-staff-id

# IM 入站白名单（allowFrom）——默认拒绝。**不设 = 沿用配对制（只放 OWNER_ID 一人）**，
# 这也是绝大多数单人部署想要的，不用配。Telegram 当前仍只允许 owner，
# 因为其会话和回复固定属于 owner。Telegram 多人接入须完成逐人隔离，详见 docs/TELEGRAM_ACCESS.md。
# ⚠ 设成空值（VORTOCODE_IM_ALLOW_FROM= 或只有逗号）表示"显式空白名单"= **拒绝一切入站消息，
#   连 owner 也拒**——不是"不限制"。想恢复默认请把整行删掉，别留个空值。
# 通道专属键（VORTOCODE_TG_ALLOW_FROM / VORTOCODE_DD_ALLOW_FROM）优先于通用键。
# 另注：群聊里机器人只在被**显式 @** 时才响应，白名单放行也不改变这条。
# VORTOCODE_IM_ALLOW_FROM=123456789,987654321
# 手机通知的安静时段（本机时区，可跨夜）：时段内只记台账、推 Desktop，结束后合成一条汇总推手机。
# VORTOCODE_QUIET_HOURS=23:00-08:00
# 同一来源、同样内容多少分钟内只推一次手机（默认 60；0 = 关）。
# VORTOCODE_NOTICE_DEDUP_MIN=60
# 早报末尾附上新闻：指向一个有 signals 采集产出（vc collect）的项目目录；只带 24 小时内的。不设 = 不带。
# VORTOCODE_ASSISTANT_NEWS_ROOT=/path/to/project
# 小智（语音音箱）接常驻助理：POST /api/voice/mcp（MCP streamable-http）的专用令牌。
# 只给「今天有什么事 / 任务单进展 / 记一张待确认提议」三个工具；主 API 令牌进不来，这个令牌也进不了别的 API。
# 只在常驻助理（通用范围）开放；不设 = 端点不存在。
# VORTOCODE_VOICE_MCP_TOKEN=

# Telegram 机器人自己的 @ 用户名（群提及门判"@ 的是不是我"要用）。不设则首次收到群消息时
# 自动 getMe 解析；设了可省这一次 API 调用。解析不出来 = 群消息一律不响应（fail-closed）。
# VORTOCODE_TG_BOT_USERNAME=my_vortocode_bot

# 记忆系统
MEMORY_STORAGE_PATH=.vortocode/memory

# 日志
LOG_LEVEL=INFO
LOG_FILE=.vortocode/logs/app.log

# Web 服务器
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Web/API 鉴权。对外暴露前必须设置为强随机值。
VORTOCODE_API_TOKEN=

# 危险能力默认关闭；只在可信本机环境中显式开启。
VORTOCODE_ENABLE_SHELL=0
VORTOCODE_ENABLE_BROWSER=0
# 桌面操作（实验功能，默认关闭）：Agent 看 Linux X11 桌面，点击/输入/按键/开应用每次都要你确认。
# 只在有人值守的 Web/Desktop 项目会话里可用。详见 docs/DESKTOP_CONTROL.md。
# VORTOCODE_ENABLE_DESKTOP_CONTROL=1
# VORTOCODE_DESKTOP_TARGET=ssh:user@desktop-vm.lan      # 或 local
# VORTOCODE_DESKTOP_APPS=xfce4-terminal,firefox
# OS shell sandbox: auto (default) | required | off.
# auto uses macOS Seatbelt / Linux bubblewrap when available. Confirmed interactive
# commands may visibly fall back; autonomous dev/test/runtime paths fail closed.
# Set off only in a trusted environment to explicitly allow host execution.
# VORTOCODE_SANDBOX=auto
# VORTOCODE_ALLOW_INSECURE_BIND=0

# 本机角色模型（与云端默认服务并存，不借用 OPENAI_API_KEY）。
# 服务需由用户自行启动；填 /v1/models 实际返回的完整模型 ID，冒号标签保留。
# Ollama: http://127.0.0.1:11434/v1；LM Studio: http://127.0.0.1:1234/v1
# VORTOCODE_PROVIDER_LOCAL_BASE=http://127.0.0.1:11434/v1
# VORTOCODE_PROVIDER_LOCAL_KEY=
# VORTOCODE_MODEL_ROLES=review=local:model-id:tag
# .vortocode/agents/<role>.md 的 model: local:model-id:tag 同样使用该端点。
# 本机启用鉴权时，LOCAL_KEY 必须填该服务自己的 token；空值不绕过鉴权。

# oMLX 同样使用原 OpenAI 兼容路由。官方默认8000；请以自己的实际端口/模型清单为准。
# VORTOCODE_PROVIDER_OMLX_BASE=http://127.0.0.1:8000/v1
# VORTOCODE_PROVIDER_OMLX_KEY=
# VORTOCODE_MODEL_ROLES=review=omlx:model-id
# oMLX启用鉴权时，OMLX_KEY必须填该实例自己的Key，不能借用默认云端Key。
