{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VortoCode",
  "version": "0.1.0",
  "identifier": "com.vorto.vortocode",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VortoCode Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; frame-src 'self' http://127.0.0.1:* http://localhost:*; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first agent development workspace",
    "longDescription": "VortoCode Desktop brings goals, sessions, reviewed edits, Git delivery, runtime evidence and project memory into one local-first agent workspace.",
    "externalBin": [
      "binaries/vortocode-runtime"
    ],
    "resources": [
      "resources/THIRD_PARTY_NOTICES.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
