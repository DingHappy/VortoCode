{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VortoCode",
  "version": "0.2.21",
  "identifier": "com.vorto.vortocode",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VortoCode Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; frame-src 'self' http://127.0.0.1:* http://localhost:*; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first agent development workspace",
    "longDescription": "VortoCode Desktop brings goals, sessions, reviewed edits, Git delivery, runtime evidence and project memory into one local-first agent workspace.",
    "resources": {
      "resources/THIRD_PARTY_NOTICES.txt": "resources/THIRD_PARTY_NOTICES.txt",
      "binaries/runtime/": "runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3Q0NGMEQ3ODhCMUNDMjkKUldRcHpMR0kxL0RNRjV3bVQ5VXJvb0lDYys3QkVVM2RCVmJ6VS9uMjdXVjBRSXdaampZbFAra0wK",
      "endpoints": [
        "https://github.com/DingHappy/VortoCode/releases/latest/download/latest.json"
      ]
    }
  }
}
