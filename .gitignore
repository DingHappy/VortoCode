# 注意：.gitignore 不支持行尾注释，注释必须独占一行

# ─────────────────────────────────────────────────────────────
# 机密 / 环境变量 —— 绝不入库
# ─────────────────────────────────────────────────────────────
.env
.env.*
# 唯一允许入库的：占位符模板（下面这行重新放行它）
!.env.example
*.pem
*.key
secrets.*
credentials.*

# ─────────────────────────────────────────────────────────────
# 运行时状态 / 产物（可再生，不应入库）
# .vortocode/ 内含 sessions.db / memory / projects / logs 等
# ─────────────────────────────────────────────────────────────
.vortocode/
*.db
*.sqlite
*.sqlite3
*.log
logs/
evals/reports/

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 桌面端 TS 源码目录 desktop/src/lib 不是 Python 构建产物，别被上面的 lib/ 规则误伤
!desktop/src/lib/

# 虚拟环境
.venv/
venv/
env/
ENV/
.python-version

# 测试 / 类型检查 / Lint 缓存
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
coverage.xml
*.profraw

# ─────────────────────────────────────────────────────────────
# 前端（web/ 若引入 Node）
# ─────────────────────────────────────────────────────────────
node_modules/
.next/
*.tsbuildinfo

# ─────────────────────────────────────────────────────────────
# 编辑器 / 操作系统
# ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────────────────────
# 本地运行时状态（Claude Code 调度锁等，非项目源）
# ─────────────────────────────────────────────────────────────
.claude/
